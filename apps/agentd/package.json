{
  "name": "@mobile-agent/agentd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "agentd": "dist/index.js"
  },
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "postinstall": "node scripts/fix-node-pty.mjs",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@mobile-agent/application": "workspace:*",
    "@mobile-agent/domain": "workspace:*",
    "@mobile-agent/persistence": "workspace:*",
    "@mobile-agent/protocol": "workspace:*",
    "hono": "^4.12.32",
    "node-pty": "^1.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
