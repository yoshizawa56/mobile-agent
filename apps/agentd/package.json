{
  "name": "@mobile-agent/agentd",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "development": "./src/server.ts",
      "import": "./dist/server.js"
    },
    "./daemon": {
      "types": "./dist/daemon.d.ts",
      "development": "./src/daemon.ts",
      "import": "./dist/daemon.js"
    }
  },
  "scripts": {
    "build": "bunx --bun tsc -p tsconfig.build.json",
    "dev": "bun --watch src/index.ts",
    "start": "bun dist/index.js",
    "test": "bun test src",
    "typecheck": "bunx --bun tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@mobile-agent/application": "workspace:*",
    "@mobile-agent/domain": "workspace:*",
    "@mobile-agent/logging": "workspace:*",
    "@mobile-agent/persistence": "workspace:*",
    "@mobile-agent/protocol": "workspace:*",
    "hono": "^4.12.32",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "bun-types": "^1.3.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
