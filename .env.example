AGENTD_HOST=127.0.0.1
AGENTD_PORT=4317
# Use an absolute path in production; the default is ~/.local/state/... when omitted.
# AGENTD_DB_FILE=/Users/you/.local/state/mobile-agent/agentd.sqlite
AGENTD_DEFAULT_TMUX_TARGET=agentd
AGENTD_AGENT_COMMAND=agent

# Optional while the current MVP relies on localhost/Tailscale ACLs.
# AGENTD_API_TOKEN=
# AGENTD_CORS_ORIGIN=https://your-web-host.example

# Web development overrides.
# VITE_DEV_HOST=0.0.0.0
# VITE_DEV_PORT=5227
# VITE_ALLOWED_HOSTS=your-machine.tailnet.ts.net
# VITE_AGENTD_HTTP_URL=http://127.0.0.1:4317
# VITE_AGENTD_WS_URL=ws://127.0.0.1:4317/terminal
# VITE_AGENTD_PROXY_TARGET=http://127.0.0.1:4317
