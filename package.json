{
  "name": "muximo",
  "version": "0.1.0",
  "private": true,
  "description": "A mobile control room for tmux-hosted agents and shells.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yoshizawa56/muximo.git"
  },
  "bugs": {
    "url": "https://github.com/yoshizawa56/muximo/issues"
  },
  "homepage": "https://github.com/yoshizawa56/muximo#readme",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "bunx --no-install turbo run build",
    "build:muximo": "bun scripts/build-muximo.mjs",
    "muximo:install": "bun scripts/install-muximo.mjs",
    "deps:check": "bun outdated",
    "dev": "bun scripts/dev.mjs",
    "audit:public": "bun scripts/audit-public-repo.mjs",
    "lint": "bunx --no-install turbo run lint",
    "test:table": "node scripts/check-table-tests.mjs",
    "test": "bun run test:table && bun test scripts/dev.test.ts && bunx --no-install turbo run test",
    "typecheck": "bunx --no-install turbo run typecheck"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.8",
    "@muximo/test-support": "workspace:*",
    "turbo": "^2.10.8"
  }
}
