{
  "name": "@mobile-agent/persistence",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bunx --bun tsc -p tsconfig.build.json",
    "db:check": "bunx --bun drizzle-kit check --config drizzle.config.ts",
    "db:generate": "bunx --bun drizzle-kit generate --config drizzle.config.ts && bun ../../scripts/sync-embedded-migrations.mjs",
    "db:migrate": "bunx --bun drizzle-kit migrate --config drizzle.config.ts",
    "test": "bun test src",
    "typecheck": "bunx --bun tsc -p tsconfig.json"
  },
  "dependencies": {
    "@mobile-agent/application": "workspace:*",
    "@mobile-agent/domain": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "@types/node": "^26.1.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
