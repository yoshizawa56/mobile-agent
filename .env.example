# The dev supervisor derives AGENT_WORKTREE_ID, AGENTD_INSTANCE_DIR,
# AGENTD_PORT, and VITE_DEV_PORT from the current worktree. The Web bundle has
# no agentd endpoint configuration; it receives the connection profile at
# runtime through QR pairing.

# Optional fixed external port for `mise run dev-serve`.
# AGENT_DEV_SERVE_PORT=443

# Optional fixed external port for `agent serve tailscale`.
# AGENT_SERVE_PORT=8444

# Optional convenience output. Tailscale status is queried automatically when
# this is omitted.
# AGENT_TAILSCALE_HOSTNAME=your-machine.tailnet.ts.net

# Explicit worktree profile values are only needed when running agentd without
# the dev supervisor (for example, a manually managed main instance).
# AGENT_WORKTREE_ID=main
# AGENTD_INSTANCE_DIR=/Users/you/.local/state/mobile-agent/main
# AGENTD_PORT=6317

# Web development overrides. The Web UI is served independently; it receives
# its agentd connection endpoint from pairing at runtime.
# VITE_ALLOWED_HOSTS=your-machine.tailnet.ts.net
# VITE_DEV_HOST=0.0.0.0
# VITE_DEV_PORT=5227

# Pairing/agentd overrides. `agent pair` uses agentd-only Tailscale Serve by
# default; use `agent pair --without-serve` for a local agentd endpoint.
# AGENTD_HOST=127.0.0.1
# AGENTD_PAIRING_BASE_URL=https://your-agentd-host.example
# AGENTD_WORKSPACE_ROOTS=/Users/you/work:/Users/you/projects
# AGENTD_TMUX_SOCKET=/Users/you/.local/state/mobile-agent/tmux.sock
# AGENTD_AGENT_COMMAND=/absolute/path/to/agent
# AGENT_LOG_LEVEL=info
# AGENT_LOG_FILE=/Users/you/.local/state/mobile-agent/agentd.log
# TAILSCALE_BIN=tailscale
