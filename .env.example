# The dev supervisor derives MUXIMO_WORKTREE_ID, MUXIMOD_INSTANCE_DIR,
# MUXIMOD_PORT, and VITE_DEV_PORT from the current worktree. The Web bundle has
# no muximod endpoint configuration; it receives the connection profile at
# runtime through QR pairing.

# Optional fixed external port for `mise run dev-serve`.
# MUXIMO_DEV_SERVE_PORT=443

# Optional fixed external port for `muximo serve tailscale`.
# MUXIMO_SERVE_PORT=8444

# Optional convenience output. Tailscale status is queried automatically when
# this is omitted.
# MUXIMO_TAILSCALE_HOSTNAME=your-machine.tailnet.ts.net

# Explicit worktree profile values are only needed when running muximod without
# the dev supervisor (for example, a manually managed main instance).
# MUXIMO_WORKTREE_ID=main
# MUXIMOD_INSTANCE_DIR=/Users/you/.local/state/muximo/main
# MUXIMOD_PORT=6317

# Web development overrides. The Web UI is served independently; it receives
# its muximod connection endpoint from pairing at runtime.
# VITE_ALLOWED_HOSTS=your-machine.tailnet.ts.net
# VITE_DEV_HOST=0.0.0.0
# VITE_DEV_PORT=5227

# Pairing/muximod overrides. `muximo pair` uses muximod-only Tailscale Serve by
# default; use `muximo pair --without-serve` for a local muximod endpoint.
# MUXIMOD_HOST=127.0.0.1
# MUXIMOD_PAIRING_BASE_URL=https://your-muximod-host.example
# MUXIMOD_WORKSPACE_ROOTS=/Users/you/work:/Users/you/projects
# MUXIMOD_TMUX_SOCKET=/Users/you/.local/state/muximo/tmux.sock
# MUXIMOD_MUXIMO_COMMAND=/absolute/path/to/muximo
# MUXIMO_LOG_LEVEL=info
# MUXIMO_LOG_FILE=/Users/you/.local/state/muximo/muximod.log
# TAILSCALE_BIN=tailscale
