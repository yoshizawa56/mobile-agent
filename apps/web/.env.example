# Copy this file to apps/web/.env.local for a bundled Capacitor build.
# These values are embedded into the Vite bundle; they are not native iOS
# build settings and must be present before `bun run cap:sync`.
# `agent serve tailscale` uses AGENT_SERVE_PORT=8444 by default.
VITE_AGENTD_HTTP_URL=https://your-machine.tailnet.ts.net:8444
VITE_AGENTD_WS_URL=wss://your-machine.tailnet.ts.net:8444/terminal

# Optional browser-development overrides.
# VITE_AGENTD_PROXY_TARGET=http://127.0.0.1:4317
# VITE_ALLOWED_HOSTS=your-machine.tailnet.ts.net
