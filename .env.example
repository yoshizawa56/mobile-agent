AGENTD_HOST=127.0.0.1
AGENTD_PORT=4317
# PID file defaults next to AGENTD_DB_FILE; override when using a service manager.
# AGENTD_PID_FILE=/Users/you/.local/state/mobile-agent/agentd.sqlite.pid
# Use an absolute path in production; the default is ~/.local/state/... when omitted.
# AGENTD_DB_FILE=/Users/you/.local/state/mobile-agent/agentd.sqlite
AGENTD_DEFAULT_TMUX_TARGET=agentd
AGENTD_AGENT_COMMAND=agent
# Colon-separated host roots exposed by the workspace picker. Defaults to the
# agentd working directory when omitted.
# AGENTD_WORKSPACE_ROOTS=/Users/you/work:/Users/you/projects
# Stable standalone binary override used by bin/agent.
# AGENT_RELEASE_BINARY=/Users/you/.local/libexec/mobile-agent/agent
# Fixed origin/main checkout used by bin/agent_main; it is not fetched automatically.
# AGENT_MAIN_DIR=/Users/you/work/mobile-agent-main
# AGENT_MAIN_STATE_ROOT=/Users/you/.local/state/mobile-agent/agent-main
# The dev launcher keeps this unset so every linked worktree shares the same tmux server.
# AGENTD_TMUX_SOCKET=/Users/you/.local/state/mobile-agent/tmux.sock
# Normally generated from the linked worktree; a manual value must be unique per worktree.
# AGENT_WORKTREE_ID=dev-worktree-id

# Optional while the current MVP relies on localhost/Tailscale ACLs.
# AGENTD_API_TOKEN=
# AGENTD_CORS_ORIGIN=https://your-web-host.example

# Web development overrides.
# VITE_DEV_HOST=0.0.0.0
# VITE_DEV_PORT=5227
# VITE_ALLOWED_HOSTS=your-machine.tailnet.ts.net
# VITE_AGENTD_HTTP_URL=http://127.0.0.1:4317
# VITE_AGENTD_WS_URL=ws://127.0.0.1:4317/terminal
# VITE_AGENTD_PROXY_TARGET=http://127.0.0.1:4317
