{
  "name": "@mobile-agent/agentd",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    "./server": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./daemon": {
      "types": "./src/daemon.ts",
      "default": "./src/daemon.ts"
    },
    "./tmux": {
      "types": "./src/tmux.ts",
      "default": "./src/tmux.ts"
    },
    "./workspace-selection": {
      "types": "./src/workspace-selection.ts",
      "default": "./src/workspace-selection.ts"
    }
  },
  "scripts": {
    "build": "bunx --bun tsc -p tsconfig.build.json",
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test src",
    "typecheck": "bunx --bun tsc -p tsconfig.json"
  },
  "dependencies": {
    "@mobile-agent/application": "workspace:*",
    "@mobile-agent/agentd-http": "workspace:*",
    "@mobile-agent/domain": "workspace:*",
    "@mobile-agent/logging": "workspace:*",
    "@mobile-agent/persistence": "workspace:*",
    "@mobile-agent/protocol": "workspace:*",
    "@mobile-agent/tailscale": "workspace:*"
  },
  "devDependencies": {
    "@mobile-agent/test-support": "workspace:*",
    "@types/node": "^26.1.2",
    "bun-types": "^1.3.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
